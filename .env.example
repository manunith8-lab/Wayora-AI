# Wayora AI Travel Concierge - Environment Configuration Example
# Copy this file to .env or configure keys directly via Settings in the application UI

# Google Maps Platform Places API (New)
# Used for Text Search, Nearby Search, Photos, and live place details
VITE_GOOGLE_MAPS_API_KEY=

# Google Gemini API Key
# Used for advanced LLM travel reasoning
VITE_GEMINI_API_KEY=
